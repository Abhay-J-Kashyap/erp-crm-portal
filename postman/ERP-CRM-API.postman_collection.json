                "exec": [
                  "pm.sendRequest({\r\n  url: pm.environment.get(\"baseUrl\") + \"/api/auth/login\",\r\n  method: \"POST\",\r\n  header: { \"Content-Type\": \"application/json\" },\r\n  body: {\r\n    mode: \"raw\",\r\n    raw: JSON.stringify({ email: \"sales@erp.com\", password: \"Password@123\" })\r\n  }\r\n}, (err, res) => {\r\n  if (!err) pm.environment.set(\"salesToken\", res.json().data.token);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{salesToken}}",
